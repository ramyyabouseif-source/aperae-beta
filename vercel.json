{
  "buildCommand": "npx expo export:web",
  "outputDirectory": "web-build",
  "devCommand": "expo start --web",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "EXPO_PUBLIC_ENV": "production"
  }
}


